# =========================
# ENV FILES (VERY IMPORTANT)
# =========================
.env
.env.*
!.env.example

# =========================
# DEPENDENCIES
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# BUILD OUTPUT
# =========================
dist/
build/
out/

# =========================
# SYSTEM FILES
# =========================
.DS_Store
Thumbs.db

# =========================
# LOGS
# =========================
logs/
*.log

# =========================
# IDE / EDITORS
# =========================
.vscode/
.idea/

# =========================
# TEST / COVERAGE
# =========================
coverage/

# =========================
# BACKEND SPECIFIC (optional)
# =========================
__pycache__/
*.pyc

# =========================
# SECURITY / KEYS
# =========================
*.pem
*.key
*.p12

# =========================
# OPTIONAL: LOCAL OVERRIDES
# =========================
.env.local
.env.development.local
.env.test.local
.env.production.local